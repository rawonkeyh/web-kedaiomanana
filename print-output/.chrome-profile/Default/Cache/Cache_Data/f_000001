<style>
  :root{
    --espresso:#2A1A12;
    --cream:#F5EDE2;
    --cream-2:#EFE6D9;
    --tan:#D6C5AC;
    --muted:#6B4A36;
    --accent:#B85C2E;
    --accent-light:#E89968;
    --ink:#1F140D;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:#D8CFBE;color:var(--ink);font-family:'Inter Tight',system-ui,sans-serif;}

  .stage{padding:40px 24px 80px;display:flex;justify-content:center;}
  .menu{
    width:840px; max-width:100%; min-width:0; min-height:1188px;
    background:var(--cream);
    padding:64px 56px 72px;
    box-shadow:0 24px 64px rgba(42,26,18,0.18);
    position:relative;
    overflow:hidden;
  }

  /* paper grain */
  .menu::before{
    content:'';position:absolute;inset:0;pointer-events:none;
    background-image:radial-gradient(rgba(42,26,18,0.04) 0.5px, transparent 0.5px);
    background-size:8px 8px;
  }
  .menu > *{position:relative;}

  /* image slots */
  .cat-hero{margin:-4px 0 14px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;}
  .cat-hero image-slot{display:block;width:100%;min-width:0;}
  .cat-hero .hero-wrap{min-width:0;}
  .hero-strip{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);gap:8px;margin:26px 0 8px;}
  .hero-strip image-slot{display:block;width:100%;min-width:0;}
  .hero-strip .hero-wrap{min-width:0;}
  .hero-wrap{position:relative;}
  .hero-cap{position:absolute;left:10px;bottom:10px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--cream);background:rgba(42,26,18,0.65);padding:4px 8px;border-radius:2px;pointer-events:none;}

  /* ─── Header ─── */
  .head{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:22px;border-bottom:1px solid var(--ink);}
  .head .lhs{}
  .head .logo .mark{font-family:'Inter Tight';font-weight:600;letter-spacing:-0.055em;font-size:48px;line-height:1;}
  .head .logo .mark .dot{color:var(--accent);}
  .head .logo .mark .lt{font-weight:300;}
  .head .logo .tag{font-family:'Inter Tight';font-weight:500;letter-spacing:0.22em;text-transform:uppercase;color:var(--muted);font-size:10px;margin-top:8px;}
  .head .rhs{text-align:right;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.22em;text-transform:uppercase;color:var(--muted);line-height:1.7;}
  .head .rhs .big{display:block;font-family:'Instrument Serif',serif;font-style:italic;font-size:38px;letter-spacing:-0.01em;color:var(--ink);text-transform:none;line-height:1;margin-bottom:8px;font-weight:400;}

  /* ─── Body grid ─── */
  /* .col uses display:contents so .cat children become direct grid items of .body.
     With grid-auto-flow:column and 4 explicit rows, sections fill column 1 (01-04)
     then column 2 (05-07). Each grid row's height = max of its paired sections,
     so the left and right category headings line up horizontally. */
  .body{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:repeat(4,auto);grid-auto-flow:column;gap:0 48px;margin-top:36px;}
  .body > .col{display:contents;}
  .body > .col > .cat{min-width:0;}

  .cat{margin-bottom:30px;break-inside:avoid;}
  .cat-hd{display:flex;align-items:baseline;gap:14px;margin-bottom:14px;}
  .cat-num{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--accent);letter-spacing:0.16em;}
  .cat-name{font-family:'Instrument Serif',serif;font-style:italic;font-size:30px;letter-spacing:-0.015em;color:var(--ink);line-height:1;}
  .cat-rule{flex:1;border-bottom:1px dotted var(--muted);opacity:0.5;margin-bottom:4px;}
  .cat-sub{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--muted);}

  .items{display:flex;flex-direction:column;}
  .sub-hd{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--accent);margin:12px 0 2px;display:flex;align-items:center;gap:8px;}
  .sub-hd::after{content:'';flex:1;border-bottom:1px dotted rgba(184,92,46,0.35);}
  .sub-hd:first-child{margin-top:0;}
  .row{display:flex;align-items:flex-end;gap:6px;padding:7px 0;border-bottom:1px solid rgba(42,26,18,0.08);}
  .row:last-child{border-bottom:none;}
  .row .nm{flex:0 1 auto;font-size:14px;font-weight:500;color:var(--ink);letter-spacing:-0.01em;line-height:1.25;}
  .row .nm small{display:block;font-weight:400;font-size:11px;color:var(--muted);margin-top:2px;letter-spacing:0;text-transform:none;}
  .row .dots{flex:1 1 24px;min-width:24px;border-bottom:1px dotted rgba(42,26,18,0.25);transform:translateY(-5px);margin:0 4px;}
  .row .pr{flex:0 0 auto;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:500;color:var(--ink);letter-spacing:0.02em;white-space:nowrap;}
  .row.feat .nm{color:var(--accent);font-weight:600;}
  .row .star{color:var(--accent);font-size:11px;margin-right:2px;}

  /* ─── Footer ─── */
  .foot{
    margin-top:36px;padding-top:22px;border-top:1px solid var(--ink);
    display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;align-items:start;
    position:relative;
  }
  .foot .blk{min-width:0;}
  .foot .blk dt{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
  .foot .blk dd{margin:0;font-size:13px;line-height:1.5;color:var(--ink);font-weight:500;}
  .foot .blk .small{font-size:11px;color:var(--muted);font-weight:400;line-height:1.5;margin-top:4px;}
  .foot .stamp{
    position:absolute;right:0;top:-110px;
    width:88px;height:88px;border-radius:50%;border:1.5px solid var(--accent);
    display:flex;align-items:center;justify-content:center;flex-direction:column;
    transform:rotate(-8deg);color:var(--accent);
  }
  .foot .stamp::after{content:'';position:absolute;inset:4px;border-radius:50%;border:1px dashed var(--accent);opacity:0.5;}
  .foot .stamp .top{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.2em;text-transform:uppercase;margin-bottom:2px;}
  .foot .stamp .big{font-family:'Instrument Serif',serif;font-style:italic;font-size:22px;line-height:1;letter-spacing:-0.02em;}
  .foot .stamp .bot{font-family:'JetBrains Mono',monospace;font-size:6px;letter-spacing:0.2em;text-transform:uppercase;margin-top:2px;}

  /* Donat split layout */
  .donat-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;align-items:stretch;}
  .donat-split .hero-wrap{display:flex;}
  .donat-split image-slot{display:block;width:100%;}
  .donat-split .right{display:flex;flex-direction:column;gap:10px;}
  .price-ladder{display:flex;gap:8px;}
  .price-ladder .tier{flex:1;background:var(--cream-2);border-radius:6px;padding:10px 12px;display:flex;flex-direction:column;gap:2px;}
  .price-ladder .qty{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--muted);}
  .price-ladder .pr{font-family:'JetBrains Mono',monospace;font-size:16px;font-weight:600;color:var(--ink);letter-spacing:0.01em;}
  .price-ladder .save{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent);margin-top:1px;}
  .topping-hd{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--muted);margin-top:6px;}
  .topping-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 14px;}
  .topping-grid .tp{display:flex;align-items:baseline;gap:6px;font-size:13px;color:var(--ink);font-weight:500;padding:4px 0;border-bottom:1px dotted rgba(42,26,18,0.18);}
  .topping-grid .tp::before{content:'○';color:var(--accent);font-size:8px;}

  /* Add-ons inline strip */
  .addons{
    margin-top:14px;padding:14px 16px;background:var(--cream-2);border-radius:6px;
    display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;
  }
  .addons .lbl{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--accent);}
  .addons .item{font-size:12px;color:var(--ink);font-weight:500;}
  .addons .item .pr{font-family:'JetBrains Mono',monospace;color:var(--muted);font-weight:400;margin-left:4px;}

  /* corner serial */
  .corner-tl, .corner-br{position:absolute;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.22em;text-transform:uppercase;color:var(--muted);}
  .corner-tl{top:20px;left:24px;}
  .corner-br{bottom:20px;right:24px;}

  @media print {
    @page { size: A4 portrait; margin: 0; }
    html,body{background:var(--cream);-webkit-print-color-adjust:exact;print-color-adjust:exact;}
    .stage{padding:0;}
    .menu{width:210mm;min-height:297mm;box-shadow:none;padding:18mm 16mm;}
  }
  /* ─── Responsive ─── */
  @media (max-width:900px){
    .stage{padding:24px 16px 60px;}
    .menu{width:100%;max-width:840px;min-height:0;padding:48px 36px 56px;}
    .body{grid-template-columns:1fr;grid-template-rows:none;grid-auto-flow:row;gap:24px;}
    .hero-strip{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;}
    .foot{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;}
    .foot .stamp{display:none;}
  }
  @media (max-width:640px){
    .stage{padding:16px 10px 40px;}
    .menu{padding:32px 20px 40px;}
    .corner-tl, .corner-br{display:none;}

    .head{flex-direction:column;align-items:flex-start;gap:14px;padding-bottom:18px;}
    .head .rhs{text-align:left;}
    .head .rhs .big{font-size:30px;margin-bottom:6px;}
    .head .logo .mark{font-size:38px;}

    .hero-strip{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;margin:20px 0 8px;}
    .hero-strip image-slot{height:130px !important;}

    .body{margin-top:24px;gap:20px;}
    .cat{margin-bottom:22px;}
    .cat-name{font-size:24px;}
    .cat-hd{gap:10px;margin-bottom:10px;}

    /* per-category photo grids are forced to 4-col via inline style — override */
    .cat-hero{grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:6px;}

    .donat-split{grid-template-columns:1fr;gap:12px;}
    .price-ladder .pr{font-size:14px;}
    .topping-grid{gap:2px 10px;}

    .foot{grid-template-columns:1fr;gap:16px;margin-top:28px;padding-top:18px;}
  }
  @media (max-width:380px){
    .menu{padding:24px 14px 32px;}
    .head .logo .mark{font-size:32px;}
    .head .rhs .big{font-size:24px;}
    .cat-name{font-size:21px;}
    .row .nm{font-size:13px;}
    .row .pr{font-size:11px;}
  }
</style>
